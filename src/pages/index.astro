---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_CONFIG } from '../cau_hinh/trang_web';
import { getPostDate, withBase } from '../utils/url';

const posts = (await getCollection('bai_viet'))
  .filter((e) => !e.data.nhap && !e.data.draft)
  .sort((a, b) => getPostDate(b).localeCompare(getPostDate(a)));

const projects = await getCollection('du_an');
const books = await getCollection('sach');
const shop = await getCollection('cua_hang');
---

<BaseLayout>
  <section class="hero">
    <div class="hero-kicker">{SITE_CONFIG.authorName} · Blog cá nhân</div>
    <h1>{SITE_CONFIG.siteTitle}</h1>
    <p class="hero-desc">{SITE_CONFIG.tagline}</p>

    <div class="hero-tools">
      <input
        id="homeSearchInput"
        type="search"
        placeholder="Tìm kiếm bài viết theo tiêu đề, chủ đề..."
        class="search-input"
      />
      <a class="hero-cta" href={withBase('/bai-viet/')}>Xem tất cả ({posts.length})</a>
    </div>
  </section>

  <section class="stats-strip">
    <a class="strip-card" href={withBase('/bai-viet/')}>
      <strong>{posts.length}</strong>
      <span>Bài viết</span>
    </a>
    <a class="strip-card" href={withBase('/du-an/')}>
      <strong>{projects.length}</strong>
      <span>Dự án</span>
    </a>
    <a class="strip-card" href={withBase('/sach/')}>
      <strong>{books.length}</strong>
      <span>Sách &amp; Tài liệu</span>
    </a>
    <a class="strip-card" href={withBase('/cua-hang/')}>
      <strong>{shop.length}</strong>
      <span>Cửa hàng</span>
    </a>
  </section>

  <section class="posts-section">
    <div class="section-head">
      <h2>Bài viết mới nhất</h2>
    </div>

    {posts.length === 0 ? (
      <p class="empty-note">Chưa có bài viết nào được xuất bản.</p>
    ) : (
      <div id="postsGrid" class="posts-grid">
        {posts.map((entry) => (
          <PostCard entry={entry} routePrefix="/bai-viet" />
        ))}
      </div>
    )}
    <p id="searchEmptyMsg" class="empty-note hidden">Không tìm thấy bài viết phù hợp với từ khóa của bạn.</p>
  </section>

  <script is:inline>
    const input = document.getElementById('homeSearchInput');
    const grid = document.getElementById('postsGrid');
    const emptyMsg = document.getElementById('searchEmptyMsg');
    if (input && grid) {
      input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        const cards = grid.querySelectorAll('.post-card');
        let visible = 0;
        cards.forEach((card) => {
          const text = card.getAttribute('data-search') || '';
          const match = !q || text.includes(q);
          card.style.display = match ? '' : 'none';
          if (match) visible++;
        });
        if (emptyMsg) {
          emptyMsg.classList.toggle('hidden', visible > 0);
        }
      });
    }
  </script>
</BaseLayout>

<style>
  .hero {
    padding: 18px 0 32px;
    border-bottom: 1px solid var(--border);
  }

  .hero-kicker {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--link);
    margin-bottom: 10px;
  }

  .hero h1 {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.1rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .hero-desc {
    margin: 0;
    max-width: 65ch;
    color: var(--text-2);
    font-size: 1.05rem;
  }

  .hero-tools {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .search-input {
    flex: 1;
    min-width: 220px;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--text);
    font-size: 0.92rem;
    font-family: inherit;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 12px;
    background: var(--accent);
    color: var(--accent-text);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none !important;
  }

  .stats-strip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 28px 0;
  }

  @media (min-width: 640px) {
    .stats-strip {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .strip-card {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 16px;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    text-decoration: none !important;
  }

  .strip-card strong {
    font-family: var(--font-display);
    font-size: 1.35rem;
  }

  .strip-card span {
    font-size: 0.82rem;
    color: var(--muted);
  }

  .section-head h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    margin: 0 0 18px;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 720px) {
    .posts-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .empty-note {
    color: var(--muted);
    padding: 24px 0;
  }

  .hidden {
    display: none;
  }
</style>
