---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../../cau_hinh/trang_web';
import {
  estimateReadingTime,
  formatVietnameseDate,
  getPostCover,
  getPostDate,
  getPostExcerpt,
  getPostSlug,
  getPostTitle,
  withBase,
} from '../../utils/url';

export async function getStaticPaths() {
  const entries = await getCollection('bai_viet');
  return entries
    .filter((e) => !e.data.nhap && !e.data.draft)
    .map((entry) => ({
      params: { slug: getPostSlug(entry) },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const title = getPostTitle(entry);
const date = getPostDate(entry);
const excerpt = getPostExcerpt(entry);
const cover = getPostCover(entry);
const category = String(entry.data?.danh_muc || entry.data?.category || 'Bài viết');
const tags: string[] = Array.isArray(entry.data?.tags)
  ? entry.data.tags
  : Array.isArray(entry.data?.cong_nghe)
  ? entry.data.cong_nghe
  : Array.isArray(entry.data?.the_loai)
  ? entry.data.the_loai
  : [];
const minutes = estimateReadingTime(entry.body || '');
const resolvedAuthor = String(entry.data?.tac_gia || entry.data?.author || SITE_CONFIG.authorName);
const pageSlug = getPostSlug(entry);
const canonicalTarget =
  entry.data?.canonical_url ||
  `${SITE_CONFIG.pagesUrl.replace(/\/+$/, '')}${withBase(`/bai-viet/${pageSlug}/`)}`;
const blogPostingJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data?.seo_title || title,
  description: entry.data?.seo_description || excerpt,
  datePublished: date,
  mainEntityOfPage: canonicalTarget,
  ...(cover ? { image: cover } : {}),
  author: {
    '@type': 'Person',
    name: resolvedAuthor,
  },
  publisher: {
    '@type': 'Person',
    name: SITE_CONFIG.authorName,
  },
};
---

<BaseLayout
  title={entry.data?.seo_title || title}
  description={entry.data?.seo_description || excerpt}
  ogImage={cover}
  noindex={Boolean(entry.data?.noindex)}
  canonical={entry.data?.canonical_url}
  jsonLd={blogPostingJsonLd}
>
  <article class="article-wrap">
    <a class="back-link" href={withBase('/bai-viet/')}>← Quay lại Bài viết</a>

    <header class="article-header">
      <div class="article-meta">
        <span>{formatVietnameseDate(date)}</span>
        <span>·</span>
        <span>{category}</span>
        <span>·</span>
        <span>{minutes} phút đọc</span>
      </div>
      <h1>{title}</h1>
      {excerpt && <p class="article-lead">{excerpt}</p>}
      {tags.length > 0 && (
        <div class="tag-row">
          {tags.map((t) => (
            <span class="tag-chip">#{t}</span>
          ))}
        </div>
      )}
    </header>

    {cover && (
      <figure class="article-cover">
        <img src={cover} alt={title} />
      </figure>
    )}

    <div class="prose">
      <Content />
    </div>

    <aside class="author-box">
      <div class="author-name">{entry.data?.tac_gia || entry.data?.author || SITE_CONFIG.authorName}</div>
      <p class="author-bio">{SITE_CONFIG.authorBio}</p>
    </aside>
  </article>
</BaseLayout>

<style>
  .article-wrap {
    max-width: 760px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    font-size: 0.88rem;
    font-weight: 500;
    margin-bottom: 18px;
  }

  .article-header {
    padding-bottom: 22px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 24px;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
    margin-bottom: 10px;
  }

  .article-header h1 {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.8vw, 2.5rem);
    line-height: 1.2;
  }

  .article-lead {
    margin: 0;
    font-size: 1.05rem;
    color: var(--text-2);
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }

  .tag-chip {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    padding: 3px 9px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-2);
  }

  .article-cover {
    margin: 0 0 28px;
  }

  .article-cover img {
    width: 100%;
    max-height: 440px;
    object-fit: cover;
    border-radius: 16px;
    border: 1px solid var(--border);
  }

  .author-box {
    margin-top: 40px;
    padding: 20px;
    border-radius: 16px;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .author-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    margin-bottom: 6px;
  }

  .author-bio {
    margin: 0;
    font-size: 0.92rem;
    color: var(--text-2);
  }
</style>
