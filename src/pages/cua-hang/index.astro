---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE_CONFIG } from '../../cau_hinh/trang_web';
import { getPostDate } from '../../utils/url';

const entries = (await getCollection('cua_hang'))
  .filter((e) => !e.data.nhap && !e.data.draft)
  .sort((a, b) => getPostDate(b).localeCompare(getPostDate(a)));
---

<BaseLayout title="Cửa hàng & Tài nguyên" description="Các ấn phẩm, bộ mẫu và tài nguyên số hữu ích.">
  <div class="col-header">
    <h1>Cửa hàng & Tài nguyên</h1>
    <p>Các ấn phẩm, bộ mẫu và tài nguyên số hữu ích.</p>
  </div>

  {entries.length === 0 ? (
    <p style="color: var(--muted);">Chưa có mục nào trong danh mục này.</p>
  ) : (
    <div class={`col-grid template-${SITE_CONFIG.templateStyle}`}>
      {entries.map((entry) => (
        <PostCard entry={entry} routePrefix="/cua-hang" />
      ))}
    </div>
  )}
</BaseLayout>

<style>
  .col-header {
    padding-bottom: 20px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }
  .col-header h1 {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-size: 2rem;
  }
  .col-header p {
    margin: 0;
    color: var(--text-2);
  }
  .col-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  @media (min-width: 720px) {
    .col-grid.template-editorial,
    .col-grid.template-visual-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .col-grid.template-minimal {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
  @media (min-width: 1024px) {
    .col-grid.template-visual-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
